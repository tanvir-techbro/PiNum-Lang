# Parser Test 3: Loops
int count = 0;
while (count < 5) {
        count = count + 1;
        if (count == 3) {
                continue;
        }
        print(count, "\n");
}

int running = 1;
while (running == 1) {
        count = count - 1;
        if (count == 1) {
                running = 0;
        }
}
print(count, "\n");
