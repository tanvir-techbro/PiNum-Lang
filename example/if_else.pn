# if / else / else if
int a = 10;
int b = 3;

# simple if
if (a > b) {
        print("a is bigger\n");
}

# if with else
if (a < b) {
        print("a is smaller\n");
} else {
        print("a is not smaller\n");
}

# else if chain
if (a < b) {
        print("a is smaller\n");
} else if (a > b) {
        print("a is bigger (else if)\n");
} else {
        print("equal\n");
}

# conditions from expressions
int sum = a + b;
if (sum == 13) {
        print("a + b is 13\n");
}

# nested if
if (a > 0) {
        if (b < 5) {
                print("a positive and b less than 5\n");
        }
}
