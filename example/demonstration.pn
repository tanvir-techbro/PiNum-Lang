# PiNum-Lang feature demonstration

# Semicolons are OPTIONAL — a newline ends a statement.
# But they ARE required to put multiple statements on one line:
#   int x = 1; print(x, "\n");   # two statements, one line

# --- variables and data types ---
int count = 10;
float ratio = 2.5
double pi = 3.14159
char letter = 'P'
string name = "PiNum"
bool ready = true
print(count, "\n")
print(ratio, "\n")
print(pi, "\n")
print(letter, "\n")
print(name, "\n")
print(ready, "\n");

# multiple statements on one line (needs semicolons)
int x = 5; print(x, "\n"); x = x * 2; print(x, "\n");

# --- arithmetic ---
int a = 10
int b = 3
print(a + b, "\n")
print(a - b, "\n")
print(a * b, "\n")
print(a / b, "\n")
print(a % b, "\n")

# --- char repetition (provided by the runtime library) ---
# 'c' * n (or n * 'c') repeats the char n times, returns a string
char bar = '='
print(bar * 30, "\n")
print('>', bar * 8, '<', "\n")
print(4 * '-', "\n")

# the multiplier can be any expression
print('#' * (a - b), "\n")

# building a pyramid is now a one-liner per row
int row = 0
while (row < 5) {
        print('*' * (row * 2 + 1), "\n")
        row = row + 1
}

# --- string addition (provided by the runtime library) ---
# "a" + "b" concatenates the two strings, returns a new string
string first = "PiNum"
string last = "-Lang"
print(first + last, "\n")
print("Hello, " + name + "!", "\n")

# --- comparisons and logicals ---
print(a > b, "\n")
print(a == b, "\n")
print(a != b, "\n")
print(a > b && b > 0, "\n")
print(a < b || b == 3, "\n")

# --- ternary ---
int max = a > b ? a : b
print(max, "\n")

# --- expressions in assignment ---
int c = 4
int result = (a + b) * 2
print(result, "\n")
result = a + b * c
print(result, "\n")

# --- compound assignment operators ---
int amount = 10
amount += 5       # same as amount = amount + 5
print(amount, "\n")
amount -= 3
print(amount, "\n")
amount *= 2
print(amount, "\n")
amount /= 3
print(amount, "\n")
amount %= 4
print(amount, "\n")

# --- increment / decrement ---
amount++
print(amount, "\n")
amount--
print(amount, "\n")

# --- if / else if / else ---
if (a > b) {
        print("a is bigger\n")
} else if (a == b) {
        print("equal\n")
} else {
        print("b is bigger\n")
}

# --- nested if ---
if (a > 0) {
        if (b > 0) {
                print("both positive\n")
        }
}

# --- while loop ---
int i = 0
while (i < 5) {
        print(i, "\n")
        i = i + 1
}

# --- break and continue ---
int j = 0
while (j < 10) {
        j = j + 1
        if (j % 2 == 0) {
                continue
        }
        if (j == 7) {
                break
        }
        print(j, "\n")
}

# --- for loop ---
for (int f = 0; f < 5; f++) {
        print(f, "\n")
}

# counted loop with a step
for (int step = 0; step < 10; step += 2) {
        print(step, "\n")
}

# counting down
for (int down = 5; down > 0; down--) {
        print(down, "\n")
}

# --- for (range) sugar ---
# for (N) runs the body N times: expands to
#   for (int __pinum_i0 = 0; __pinum_i0 < N; __pinum_i0++)
for (5) {
        print("beep\n")
}

# the range is any expression, evaluated each iteration
int sides = 3
for (sides) {
        print("side\n")
}

# nested range loops each get a unique hidden counter, so uniforms are easy
for (3) {
        for (2) {
                print("*")
        }
        print("\n")
}

# --- vec<T> — a growable vector, monomorphized per element type ---
vec<int> nums = [3, 5, 6]
print(nums, "\n")
vec<float> ratios = [1.5, 2.5]
print(ratios, "\n")
vec<string> words = ["PiNum", "rocks"]
print(words, "\n")
vec<int> empty = []
print(empty, "\n")

# --- read user input ---
int data
print('Enter a number: ')
read(data)
print("you entered ", data, "\n")

# --- return ---
int m = 0
while (m < 10) {
        print(m, "\n")
        if (m == 3) {
                return 0
        }
        m = m + 1
}
print("never reached\n")